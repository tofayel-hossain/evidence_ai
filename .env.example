# EvidenceAI Configuration

# Project Metadata
PROJECT_NAME=EvidenceAI
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
# Primary: PostgreSQL (production / local Postgres service)
# Example PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/evidenceai
# Fallback / Quickstart: SQLite (works out-of-the-box without running a Postgres daemon)
DATABASE_URL=sqlite:///./evidenceai.db

# Security & Authentication
SECRET_KEY=evidenceai-super-secret-dev-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage & Limits
UPLOAD_DIR=./data/uploads
INDEX_DIR=./data/indices
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf

# AI / ML Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small

# Chunking Parameters
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100

# Retrieval Parameters
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.5

# LLM Answer Generation Provider
# Options: 'fallback' (smart local evidence synthesis, no external API needed),
#          'groq' (ultra-fast Llama-3 via Groq Cloud),
#          'openai' (GPT-4o / GPT-3.5),
#          'ollama' (local llama3/mistral)
LLM_PROVIDER=fallback
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama-3.1-8b-instant
